NODE_ENV=production
APP_URL=https://your-domain.com
JWT_SECRET=                # long random string
OWNER_PASSWORD=            # password for the owner accounts (free full access)
OWNER_EMAILS=hsw365media@gmail.com,hoodstarent365@gmail.com

# Lip sync engine (https://fal.ai/dashboard/keys)
FAL_KEY=
FAL_MODEL_VIDEO=fal-ai/latentsync
# Optional premium photo model for the plans listed (costs far more per second):
# FAL_MODEL_PHOTO=veed/fabric-1.0
# FAL_PHOTO_PLANS=elite
# FAL_PHOTO_RESOLUTION=480p

# Stripe (run `npm run stripe:setup` to create the prices)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ELITE=

# Database + durable file storage (Supabase). Without these the app uses an
# embedded database and local disk under DATA_DIR.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sync365
